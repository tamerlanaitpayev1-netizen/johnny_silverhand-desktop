<Window x:Class="JohnnyOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JohnnyOverlay" Width="560" Height="370"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">

    <!-- Горизонтальная компоновка точь-в-точь как в capri-desktop (YouTube Shorts sEAqdBnvUCU):
         Слева — компактный терминал чата и кнопки TYPE / TALK, справа — сам персонаж со свешенными ногами -->
    <Grid ClipToBounds="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="255"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: Терминал реплик и ввода в стиле Capri Mainframe / Night City Terminal -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right"
                    Width="295" Margin="8,16,4,16">

            <!-- Терминальное окно реплики (справа от него сидит Джонни) -->
            <Border x:Name="SpeechBubble" Padding="12,10" Margin="0,0,0,6"
                    Background="#F0090D14" BorderBrush="#00F0FF" BorderThickness="1.5"
                    CornerRadius="3,10,3,10" Visibility="Visible">
                <Border.Effect>
                    <DropShadowEffect Color="#00F0FF" BlurRadius="14" ShadowDepth="0" Opacity="0.40"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Плашка сбоя биочипа Relic -->
                    <Border x:Name="RelicStatusBanner" Background="#33FF2A55" BorderBrush="#FF2A55"
                            BorderThickness="1" Padding="6,2" Margin="0,0,0,6" Visibility="Collapsed">
                        <TextBlock Text="⚡ RELIC MALFUNCTION // ENGRAM TENDRILS"
                                   Foreground="#FCEE09" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold"/>
                    </Border>

                    <!-- Шапка терминала как в видео (JOHNNY / NIGHT-CITY... [RELIC]) -->
                    <DockPanel Margin="0,0,0,6">
                        <Border Background="#2200F0FF" BorderBrush="#00F0FF" BorderThickness="1"
                                CornerRadius="2" Padding="4,1" Margin="0,0,6,0">
                            <TextBlock Text="RELIC" Foreground="#00F0FF" FontFamily="Consolas"
                                       FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="JOHNNY // NIGHT-CITY" Foreground="#FCEE09"
                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel x:Name="VoiceEqPanel" Orientation="Horizontal" Margin="0,0,6,0"
                                        VerticalAlignment="Center" Visibility="Collapsed">
                                <Rectangle x:Name="EqBar1" Width="3" Height="10" Fill="#FF2A55" Margin="1,0"/>
                                <Rectangle x:Name="EqBar2" Width="3" Height="14" Fill="#00F0FF" Margin="1,0"/>
                                <Rectangle x:Name="EqBar3" Width="3" Height="8" Fill="#FCEE09" Margin="1,0"/>
                                <Rectangle x:Name="EqBar4" Width="3" Height="12" Fill="#00F0FF" Margin="1,0"/>
                            </StackPanel>
                            <Border Background="#2200FF88" BorderBrush="#00FF88" BorderThickness="1"
                                    CornerRadius="2" Padding="4,1">
                                <TextBlock x:Name="ModeStatusText" Text="60FPS" Foreground="#00FF88"
                                           FontFamily="Consolas" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Текст ответа Джонни -->
                    <TextBlock x:Name="SpeechText"
                               Text="Просыпайся, самурай. Тащи меня за шкирку на любое окно или жми TYPE."
                               Foreground="#F2F6FA" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                               LineHeight="17"/>
                </StackPanel>
            </Border>

            <!-- Строка ввода в стиле терминала Капри: > you: ... -->
            <Border x:Name="InputPanel" Margin="0,0,0,6" Background="#F5090D14"
                    BorderBrush="#FCEE09" BorderThickness="1.5" CornerRadius="3" Padding="8,6" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock Text="&gt; you: " Foreground="#00F0FF" FontFamily="Consolas" FontWeight="Bold"
                               FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                    <TextBox x:Name="PromptTextBox" Background="Transparent" Foreground="#FCEE09"
                             CaretBrush="#00F0FF" BorderThickness="0" FontFamily="Consolas" FontSize="12.5"
                             KeyDown="PromptTextBox_KeyDown"
                             ToolTip="Напиши Джонни и нажми Enter (Esc — скрыть)"/>
                </DockPanel>
            </Border>

            <!-- Киберпанк-кнопки TYPE / SCREEN / RIFF (появляются при наведении как Pencil/Wave у Капри) -->
            <Border x:Name="QuickActionBar" HorizontalAlignment="Right"
                    Background="#E6090D14" BorderBrush="#00F0FF" BorderThickness="1" CornerRadius="3" Padding="4,3"
                    Opacity="0.88">
                <StackPanel Orientation="Horizontal">
                    <Button Content="✎ TYPE" Click="QuickChat_Click"
                            Background="#2200F0FF" Foreground="#00F0FF" BorderBrush="#00F0FF" BorderThickness="1"
                            FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Padding="7,2" Margin="2,0" Cursor="Hand"/>
                    <Button Content="👁 SCREEN" Click="MenuWatchScreen_Click"
                            Background="#22FCEE09" Foreground="#FCEE09" BorderBrush="#FCEE09" BorderThickness="1"
                            FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Padding="7,2" Margin="2,0" Cursor="Hand"/>
                    <Button Content="🎸 RIFF" Click="MenuPlayGuitar_Click"
                            Background="#22FF2A55" Foreground="#FF2A55" BorderBrush="#FF2A55" BorderThickness="1"
                            FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Padding="7,2" Margin="2,0" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ПРАВАЯ КОЛОНКА: 60 FPS Живой Персонаж со свешенными ногами, физикой маятника и щупальцами глитчей -->
        <Grid x:Name="AvatarContainer" Grid.Column="1" Width="245" Height="345"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="Hand" ClipToBounds="False"
              MouseLeftButtonDown="Avatar_MouseLeftButtonDown"
              MouseMove="Avatar_MouseMove"
              MouseLeftButtonUp="Avatar_MouseLeftButtonUp"
              MouseEnter="Avatar_MouseEnter"
              MouseLeave="Avatar_MouseLeave">
            <!-- Пивот вращения всего тела сверху (в точке захвата курсором мыши при перетаскивании!) -->
            <Grid.RenderTransformOrigin>
                <Point X="0.52" Y="0.22"/>
            </Grid.RenderTransformOrigin>
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="AvatarScale" ScaleX="1.0" ScaleY="1.0"/>
                    <RotateTransform x:Name="AvatarPendulumRotate" Angle="0"/>
                    <TranslateTransform x:Name="AvatarTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.Effect>
                <DropShadowEffect x:Name="JohnnyDropShadow" Color="#00F0FF" BlurRadius="18" ShadowDepth="0" Opacity="0.85"/>
            </Grid.Effect>

            <!-- Контекстное меню по правому клику -->
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="✎ Написать Джонни (Alt+J)" Click="QuickChat_Click"/>
                    <MenuItem Header="👁 Прокомментировать мой экран (Vision)" Click="MenuWatchScreen_Click"/>
                    <MenuItem Header="🎸 Сыграть рифф Samurai (Гитара)" Click="MenuPlayGuitar_Click"/>
                    <Separator/>
                    <MenuItem x:Name="MenuSnapItem" Header="📌 Посадка на край активного окна: ВКЛ" Click="MenuToggleSnap_Click"/>
                    <MenuItem x:Name="MenuControlItem" Header="💊 Псевдоэндотризин (Управление ПК): ВКЛ" Click="MenuToggleControl_Click"/>
                    <MenuItem x:Name="MenuCheckInItem" Header="⏱ Фоновые реакции (раз в 12 мин): ВКЛ" Click="MenuToggleCheckIn_Click"/>
                    <Separator/>
                    <MenuItem Header="📝 Редактировать характер (personality.md)" Click="MenuOpenPersonality_Click"/>
                    <MenuItem Header="🧠 Редактировать память о Ви (me.md)" Click="MenuOpenMemory_Click"/>
                    <MenuItem Header="🙈 Скрыть в трей (Ctrl+Alt+H)" Click="MenuHideToTray_Click"/>
                    <Separator/>
                    <MenuItem Header="❌ Отключить биочип (Выход)" Click="MenuExit_Click"/>
                </ContextMenu>
            </Grid.ContextMenu>

            <Grid Width="240" Height="329" ClipToBounds="False">

                <!-- Слой 0: Анимированные багрово-голубые щупальца и осколки глитчей (Glitch Tendrils как у Капри) -->
                <Canvas x:Name="GlitchTendrilsCanvas" Width="240" Height="329" IsHitTestVisible="False"/>

                <!-- Слой 1: Многослойный скелетный риг (10 независимых костей) -->
                <Grid x:Name="RigRootGrid" Width="240" Height="329" ClipToBounds="False">

                    <!-- Левая нога (пивот бедра: 0.42, 0.78 — качается над заголовком окна и дрыгается при захвате!) -->
                    <Image x:Name="RigLegLeftImage" Width="240" Height="329" Stretch="Fill"
                           RenderTransformOrigin="0.42,0.78" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="LegLeftRotate" Angle="0"/>
                                <TranslateTransform x:Name="LegLeftTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Правая нога (пивот бедра: 0.60, 0.78 — качается в противофазе левой ноге!) -->
                    <Image x:Name="RigLegRightImage" Width="240" Height="329" Stretch="Fill"
                           RenderTransformOrigin="0.60,0.78" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="LegRightRotate" Angle="0"/>
                                <TranslateTransform x:Name="LegRightTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Пояс / таз (точка опоры прямо на рамке окна Windows) -->
                    <Image x:Name="RigLowerImage" Width="240" Height="329" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Дышащий торс + руки + голова (пивот на поясе: 0.525, 0.754) -->
                    <Grid x:Name="TorsoContainer" Width="240" Height="329" RenderTransformOrigin="0.525,0.754">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="TorsoScale" ScaleX="1.0" ScaleY="1.0"/>
                                <RotateTransform x:Name="TorsoRotate" Angle="0"/>
                                <TranslateTransform x:Name="TorsoTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- Задние пряди волос (развеваются с инерцией позади плеч) -->
                        <Image x:Name="RigHairBackImage" Width="240" Height="329" Stretch="Fill"
                               RenderTransformOrigin="0.525,0.18" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform x:Name="HairSkew" AngleX="0" AngleY="0"/>
                                    <RotateTransform x:Name="HairRotate" Angle="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Бронежилет Samurai -->
                        <Image x:Name="RigTorsoImage" Width="240" Height="329" Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Левая серебряная бионическая рука (пивот кибер-плеча: 0.753, 0.408) -->
                        <Image x:Name="RigArmLeftImage" Width="240" Height="329" Stretch="Fill"
                               RenderTransformOrigin="0.753,0.408" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="ArmLeftRotate" Angle="0"/>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Голова + блик авиаторов + челюсть Lip-Sync (пивот шеи: 0.525, 0.255) -->
                        <Grid x:Name="HeadContainer" Width="240" Height="329" RenderTransformOrigin="0.525,0.255">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform x:Name="HeadRotate" Angle="0"/>
                                    <TranslateTransform x:Name="HeadTranslate" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- Голова и очки-авиаторы -->
                            <Image x:Name="RigHeadImage" Width="240" Height="329" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Анимированный неоновый блик авиаторов / моргание визора -->
                            <Image x:Name="RigGlassesGlintImage" Width="240" Height="329" Stretch="Fill"
                                   Opacity="0.85" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.RenderTransform>
                                    <TranslateTransform x:Name="GlintTranslate" X="0" Y="0"/>
                                </Image.RenderTransform>
                            </Image>

                            <!-- Нижняя челюсть / борода (Lip-Sync) -->
                            <Image x:Name="RigJawImage" Width="240" Height="329" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.RenderTransform>
                                    <TranslateTransform x:Name="JawTranslate" X="0" Y="0"/>
                                </Image.RenderTransform>
                            </Image>
                        </Grid>

                        <!-- Электрогитара Deluze Orphean -->
                        <Image x:Name="RigGuitarImage" Width="240" Height="329" Stretch="Fill"
                               RenderTransformOrigin="0.52,0.62" Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="GuitarRotate" Angle="0"/>
                            </Image.RenderTransform>
                        </Image>

                        <!-- Правая рука с дымящейся сигаретой (пивот плеча: 0.316, 0.408) -->
                        <Grid Width="240" Height="329" RenderTransformOrigin="0.316,0.408">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="ArmRightRotate" Angle="0"/>
                            </Grid.RenderTransform>
                            <Image x:Name="RigArmRightImage" Width="240" Height="329" Stretch="Fill"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Ellipse x:Name="CigaretteEmber" Width="8" Height="8" Fill="#FF4500"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,119,0,0"
                                     Opacity="0.85" IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                    </Grid>

                    <!-- Генератор дыма от сигареты (60 FPS) -->
                    <Canvas x:Name="SmokeCanvas" Width="240" Height="329" IsHitTestVisible="False"/>
                </Grid>

                <!-- Полнокадровый оверлей для сбоя Relic -->
                <Image x:Name="SpecialStateImage" Width="240" Height="329" Stretch="Uniform"
                       Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Бегущий луч голографического сканирования -->
                <Border x:Name="ScanlineBeam" Width="210" Height="2" VerticalAlignment="Top"
                        HorizontalAlignment="Center" Background="#4400F0FF" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ScanlineTranslate" X="0" Y="20"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

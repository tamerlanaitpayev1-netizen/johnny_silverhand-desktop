<Window x:Class="JohnnyOverlay.MainframeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RELIC MAINFRAME v2.077 // НАСТРОЙКИ ЭНГРАММЫ" Width="500" Height="450"
        WindowStartupLocation="CenterScreen" Background="#090D14" Foreground="#F2F6FA"
        ResizeMode="NoResize" Topmost="True">

    <Border BorderBrush="#00F0FF" BorderThickness="1.5" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка окна настроек -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="⚙ RELIC MAINFRAME // JOHNNY SILVERHAND v2.0"
                           Foreground="#FCEE09" FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                <TextBlock x:Name="StatusBadge" Text="[ONLINE]" Foreground="#00FF88"
                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right"/>
            </DockPanel>

            <!-- Вкладки: МОЗГ / ГОЛОС / ПОВЕДЕНИЕ И АНИМАЦИИ -->
            <TabControl Grid.Row="1" Background="#0F1622" BorderBrush="#00F0FF" Foreground="#F2F6FA" FontFamily="Consolas">

                <!-- ВКЛАДКА 1: МОЗГ (BRAIN) -->
                <TabItem Header="🧠 МОЗГ (BRAIN)" Foreground="#090D14" FontWeight="Bold">
                    <StackPanel Margin="12">
                        <TextBlock Text="Режим языковой модели (LLM):" Foreground="#00F0FF" Margin="0,0,0,6"/>
                        <RadioButton x:Name="RadioOllama" Content="Локальная Ollama (qwen2.5:7b на RTX 5060 — оффлайн)"
                                     Foreground="#F2F6FA" IsChecked="True" Margin="0,0,0,6"/>
                        <RadioButton x:Name="RadioCloud" Content="Игровой режим Zero-VRAM (NVIDIA NIM / Groq / OpenRouter)"
                                     Foreground="#F2F6FA" Margin="0,0,0,10"/>

                        <TextBlock Text="API-ключ для облачного Zero-VRAM режима (опционально):" Foreground="#00F0FF" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="ApiKeyBox" Background="#162030" Foreground="#FCEE09" BorderBrush="#00F0FF" Padding="5" Margin="0,0,0,12"/>

                        <Button Content="🔌 Проверить связь с ядром (/health)" Click="BtnCheckHealth_Click"
                                Background="#2200F0FF" Foreground="#00F0FF" BorderBrush="#00F0FF" Padding="8,5" Margin="0,0,0,8" Cursor="Hand"/>
                        <TextBlock x:Name="HealthResultText" Text="Статус: готов к проверке."
                                   Foreground="#FCEE09" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                </TabItem>

                <!-- ВКЛАДКА 2: ГОЛОС (VOICE) -->
                <TabItem Header="🔊 ГОЛОС (VOICE)" Foreground="#090D14" FontWeight="Bold">
                    <StackPanel Margin="12">
                        <CheckBox x:Name="ChkVoiceEnabled" Content="Включить русскую озвучку Джонни (TTS / RVC + Relic DSP)"
                                  Foreground="#F2F6FA" IsChecked="True" Margin="0,0,0,12"/>

                        <TextBlock Text="Интенсивность кибер-фильтра биочипа Relic (DSP):" Foreground="#00F0FF" Margin="0,0,0,4"/>
                        <Slider x:Name="SliderDspStrength" Minimum="0.0" Maximum="2.0" Value="1.0"
                                TickFrequency="0.2" IsSnapToTickEnabled="True" Margin="0,0,0,14"/>

                        <Button Content="📂 Открыть папку для RVC-модели Ильи Бледного (.pth)" Click="BtnOpenRvcFolder_Click"
                                Background="#22FCEE09" Foreground="#FCEE09" BorderBrush="#FCEE09" Padding="8,5" Margin="0,0,0,8" Cursor="Hand"/>
                        <Button Content="🎙 Записать голосовую команду с микрофона (/listen)" Click="BtnVoiceListen_Click"
                                Background="#22FF2A55" Foreground="#FF2A55" BorderBrush="#FF2A55" Padding="8,5" Cursor="Hand"/>
                    </StackPanel>
                </TabItem>

                <!-- ВКЛАДКА 3: ПОВЕДЕНИЕ И ЛЕНТЫ (HABITS) -->
                <TabItem Header="🎸 ПОВЕДЕНИЕ (HABITS)" Foreground="#090D14" FontWeight="Bold">
                    <StackPanel Margin="12">
                        <TextBlock Text="Масштаб персонажа (Tiny 60% — Normal 100% — Giant 140%):" Foreground="#00F0FF" Margin="0,0,0,4"/>
                        <Slider x:Name="SliderScale" Minimum="0.6" Maximum="1.4" Value="1.0"
                                ValueChanged="SliderScale_ValueChanged" Margin="0,0,0,10"/>

                        <TextBlock Text="Частота обновления скелетной физики (15 — 60 FPS):" Foreground="#00F0FF" Margin="0,0,0,4"/>
                        <Slider x:Name="SliderFps" Minimum="15" Maximum="60" Value="60"
                                ValueChanged="SliderFps_ValueChanged" Margin="0,0,0,12"/>

                        <TextBlock Text="Проиграть покадровую экшен-ленту (Этап 11 Sprite Strips):" Foreground="#FCEE09" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2" Rows="2">
                            <Button Content="⚡ Телепорт Beam-In" Click="BtnStripBeam_Click" Margin="2" Padding="5,4"
                                    Background="#2200F0FF" Foreground="#00F0FF" BorderBrush="#00F0FF" Cursor="Hand"/>
                            <Button Content="🔫 Пистолет Malorian" Click="BtnStripMalorian_Click" Margin="2" Padding="5,4"
                                    Background="#22FF2A55" Foreground="#FF2A55" BorderBrush="#FF2A55" Cursor="Hand"/>
                            <Button Content="💤 Сон Standby" Click="BtnStripSleep_Click" Margin="2" Padding="5,4"
                                    Background="#22FCEE09" Foreground="#FCEE09" BorderBrush="#FCEE09" Cursor="Hand"/>
                            <Button Content="🚶 Походка Walk" Click="BtnStripWalk_Click" Margin="2" Padding="5,4"
                                    Background="#2200FF88" Foreground="#00FF88" BorderBrush="#00FF88" Cursor="Hand"/>
                        </UniformGrid>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Нижняя панель сохранения -->
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <Button Content="💾 Применить и сохранить" Click="BtnSave_Click"
                        Background="#00F0FF" Foreground="#090D14" FontFamily="Consolas" FontWeight="Bold"
                        Padding="14,6" DockPanel.Dock="Right" Cursor="Hand"/>
                <TextBlock Text="Хоткеи: Alt+J (Чат) | Ctrl+Alt+H (Скрыть) | Shift+Drag (Фиксация)"
                           Foreground="#88A0B8" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
